# Copy to config/defaults.env and edit before bootstrap (optional).
# ./bin/bootstrap loads config/defaults.env if present.

# Linux account used for SSH + Docker (Kamal can use this or root).
DEPLOY_USER=deploy

# Personal admin account in addition to deploy (empty = only deploy).
# `ars install` and bootstrap create this user and install authorized_keys.
# Example: OPERATOR_USER=rob
OPERATOR_USER=

# Hostname for `ars install`. Empty + ASK_HOSTNAME=1 prompts on the live console.
HOSTNAME=
ASK_HOSTNAME=1
TIMEZONE=UTC

# Comma-separated public key paths or inline keys are not supported here —
# place authorized keys in:
#   config/authorized_keys   (one OpenSSH public key per line)
# Bootstrap installs them for OPERATOR_USER, DEPLOY_USER, and optionally root.
INSTALL_ROOT_AUTHORIZED_KEYS=1

# SSH hardening
SSH_PASSWORD_AUTHENTICATION=no
SSH_PERMIT_ROOT_LOGIN=prohibit-password

# Firewall (nftables)
FIREWALL_ENABLE=1
FIREWALL_ALLOW_SSH=1
FIREWALL_ALLOW_HTTP=1
FIREWALL_ALLOW_HTTPS=1
# Extra TCP ports, comma-separated (e.g. metrics): empty by default
# FIREWALL_EXTRA_TCP=

# Docker
DOCKER_ENABLE=1
# Install docker-compose plugin package (docker-compose)
DOCKER_COMPOSE=1
# Install buildx package when available
DOCKER_BUILDX=1

# Time sync (systemd-timesyncd is usually enough on Arch)
ENABLE_TIMESYNCD=1

# Optional host packages (space-separated pacman names)
# EXTRA_PACKAGES="htop tmux"
